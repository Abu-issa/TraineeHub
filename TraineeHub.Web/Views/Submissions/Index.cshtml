@model List<TraineeHub.Web.ViewModels.Submissions.SubmissionListItemVm>

@{
    ViewData["Title"] = "Review Submissions";
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<h1 class="mb-3">Review Submissions</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Submit Assignment</a>
</p>

<form method="get" asp-action="Index" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <select name="status" class="form-select">
                <option value="">-- All Statuses --</option>
                <option value="Submitted" selected="@(selectedStatus == "Submitted")">Submitted</option>
                <option value="Approve" selected="@(selectedStatus == "Approve")">Approved</option>
                <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
                <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">Filter</button>
        </div>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Trainee</th>
            <th>Assignment</th>
            <th>Notes</th>
            <th>Status</th>
            <th>Submitted At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var submission in Model)
        {
            <tr>
                <td>@submission.TraineeFullName</td>
                <td>@submission.AssignmentTitle</td>
                <td>@submission.Notes</td>
                <td>@submission.Stauts</td>
                <td>@submission.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (submission.Stauts == TraineeHub.Domain.Enum.SubmissionStatus.Submitted ||
                                    submission.Stauts == TraineeHub.Domain.Enum.SubmissionStatus.Pending)
                    {
                        <form asp-action="Approve" asp-route-id="@submission.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>

                        <form asp-action="Reject" asp-route-id="@submission.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-danger">
                            Cannot review because status is @submission.Stauts
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>