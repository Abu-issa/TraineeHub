@model TraineeHub.Web.ViewModels.Trainees.TraineeDetailsVm

@{
    ViewData["Title"] = "Trainee Details";
}

<h1 class="mb-4">Trainee Details</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title mb-3">@Model.FullName</h4>

        <dl class="row">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Submission Count</dt>
            <dd class="col-sm-9">@Model.SubmissionCount</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>