@model TraineeHub.Web.ViewModels.Dashboard.DashboardVm

@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Dashboard</h1>

<div class="mb-3">
    @if (Model.FromCache)
    {
        <span class="badge bg-success">Loaded from Redis Cache</span>
    }
    else
    {
        <span class="badge bg-warning text-dark">Loaded from Database</span>
    }
</div>

<form asp-action="RefreshCache" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Refresh Cache</button>
</form>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Trainees</h5>
                <h2>@Model.TraineesCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Topics</h5>
                <h2>@Model.TopicsCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Assignments</h5>
                <h2>@Model.AssignmentsCount</h2>
            </div>
        </div>
    </div>
</div>

<h3 class="mb-3">Submissions by Status</h3>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Pending</h5>
                <h2>@Model.PendingSubmissionsCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Submitted</h5>
                <h2>@Model.SubmittedSubmissionsCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Approved</h5>
                <h2>@Model.ApprovedSubmissionsCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Rejected</h5>
                <h2>@Model.RejectedSubmissionsCount</h2>
            </div>
        </div>
    </div>
</div>